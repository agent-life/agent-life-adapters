# Hermes multi-agent reference install — research spike (NO alf installed).
#
# A typical/idiomatic non-root install with TWO agents implemented the native
# Hermes way: PROFILES (each a fully-isolated HERMES_HOME). Distinct from the
# existing seed.py/verify_open.py round-trip testkit in this dir.
#
# The Hermes installer self-installs its own Node 22 (from nodejs.org) and uv,
# so the base image only needs git/curl/xz + a C toolchain for wheels. This is
# a HEAVY build (uv sync + Node frontend build).
#
# Build:   docker build -f Dockerfile.multiagent -t hermes-multiagent .
# Inspect: ./inspect-multiagent.sh
FROM debian:bookworm-slim

ARG HERMES_BRANCH=main
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates curl git xz-utils sqlite3 tree build-essential \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -m -s /bin/bash agent
USER agent
WORKDIR /home/agent
ENV HERMES_HOME=/home/agent/.hermes

# Idiomatic install, non-interactive: skip the API-key setup wizard and the
# heavy Playwright/Chromium browser download; keep the default bundled skills.
RUN curl -fsSL https://hermes-agent.nousresearch.com/install.sh \
      | bash -s -- --non-interactive --skip-setup --skip-browser --branch "${HERMES_BRANCH}"

ENV PATH="/home/agent/.local/bin:${PATH}"
CMD ["bash"]
