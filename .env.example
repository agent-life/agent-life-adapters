# agent-life-adapters — environment for the cloud test lanes.
# Copy to .env and fill in. NEVER commit the real .env (gitignored).
#
# Consumers:
#   * scripts/integration_walkthrough*.py       — all five keys below
#   * tests/lifecycle/ (the lifecycle harness)   — only the OPTIONAL enrichment
#     lanes read this file; the required ⊙ API lane authenticates with a
#     per-run runtime key minted from the service checkout (ALF_SERVICE_REPO).
#   * ./test.sh walkthroughs / lifecycle-llm     — gate on these being present.

# The sync/API service base URL.
# /v1 wrinkle: a custom-domain base carries NO /v1 suffix; a raw execute-api
# URL carries it in the base. The harness's ApiClient probes once and toggles
# the prefix automatically — either shape works here.
API_BASE_URL=https://agent-life-api-test.example.com

# A service API key (walkthroughs only; the lifecycle harness mints its own).
API_KEY=

# Neon Postgres owner DSN for the *test* branch (optional enrichment lane).
# NOTE: the Neon test branch auto-expires every few days — connection failures
# here usually mean "recreate the branch", not a bug in your change.
NEON_DATABASE_URL=postgres://user:password@host.neon.tech/agentlife?sslmode=require

# S3 bucket holding snapshots/deltas for the test stage (optional enrichment
# lane; boto3 also needs ambient AWS credentials).
S3_BUCKET_NAME=agent-life-data-test
AWS_REGION=us-east-2

# LLM proxy Function URL (informational; the lifecycle harness gets the
# per-run value from the provisioner output).
LLM_PROXY_URL=

# Path to the agent-life-service checkout (provisioner + scavenger live
# there). Default when unset: ../agent-life-service
#ALF_SERVICE_REPO=../agent-life-service
