# agent-life-adapters — environment for the cloud test lanes.
# Copy to .env and fill in. NEVER commit the real .env (gitignored).
#
# HARD RULE: adapters tests read config ONLY from THIS file. Nothing in this
# repo reads the sibling agent-life-service checkout's .env (or any other
# repo's). The service checkout supplies the mint/scavenge *binary* (see
# ALF_SERVICE_REPO below); its configuration is never consulted — the lifecycle
# harness invokes the `e2e` cargo bins directly with an environment built
# solely from the values here (alflab/config.py:subprocess_env). This keeps a
# service-side stage toggle from silently redirecting a test at prod.
#
# Consumers:
#   * tests/lifecycle/ (the lifecycle harness, --backend real): mints + probes +
#     scavenges using every REQUIRED key below.
#   * scripts/integration_walkthrough*.py: same REQUIRED keys.
#   * ./test.sh live tiers: gate on these being present.

# ─── REQUIRED for --backend real (mint + probe + direct DB/S3 seed) ──────────

# The sync/API service base URL. Becomes the minted ALF_API_URL and the P4
# probe target — MUST point at the SAME stage as NEON_DATABASE_URL below (a key
# minted in the test branch only authenticates against the test API).
# /v1 wrinkle: a custom-domain base carries NO /v1 suffix; a raw execute-api
# URL carries it. The harness's ApiClient probes once and toggles automatically.
API_BASE_URL=https://agent-life-api-test.example.com

# A service API key (walkthroughs authenticate with this; the lifecycle harness
# mints its own per-run runtime key and does not use this).
API_KEY=

# Neon Postgres DSN for the TEST branch. The mint bin does direct inserts
# (tenant/agent/runtime/api-key) and the scavenger deletes them, so this needs
# a role with write access to those tables (the app role is sufficient).
# NOTE: the Neon test branch auto-expires every few days — connection failures
# here usually mean "recreate the branch", not a bug in your change.
NEON_DATABASE_URL=postgres://user:password@host.neon.tech/agentlife?sslmode=require

# S3 bucket for the test stage — the mint uploads the seed .alf here and the
# scavenger removes it. MUST be the test bucket (matching the DB/API stage).
S3_BUCKET_NAME=agent-life-data-test

# AWS region + credentials for that bucket. Credentials may instead come from
# the ambient environment / an AWS profile (~/.aws) — the harness forwards the
# process environment, so an already-working `aws s3 ls` needs nothing here.
AWS_REGION=us-east-2
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=

# LLM proxy Function URL for the proxy tier. Echoed into the minted config and
# used by the in-container agent; MUST be the test-stage proxy.
LLM_PROXY_URL=

# ─── Location of the service checkout (BINARY only, never its .env) ──────────
# Where the `e2e` mint + scavenge binaries are built from. This is the ONLY
# permitted reference to the service repo, and it is a code path, not config.
# Default when unset: ../agent-life-service
#ALF_SERVICE_REPO=../agent-life-service
